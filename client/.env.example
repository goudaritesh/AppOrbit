# ==============================================================================
# APPORBIT CLIENT — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend API Root Endpoint (must match EXACTLY — axios.js reads VITE_API_BASE_URL)
VITE_API_BASE_URL=http://localhost:5000/api

# Client Base Application URL
VITE_APP_URL=http://localhost:5173

# Real-time WebSockets Server Endpoint
VITE_SOCKET_URL=http://localhost:5000

# Error Monitoring & Observability (Sentry Client DSN)
VITE_SENTRY_DSN=

# Firebase Cloud Messaging Client Configuration (Optional)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
