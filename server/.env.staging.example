# ==============================================================================
# APPORBIT SERVER — STAGING CONFIGURATION TEMPLATE (.env.staging)
# ==============================================================================

NODE_ENV=staging
PORT=5000

# Staging Database (Isolated from production)
MONGODB_URI=mongodb+srv://<staging_user>:<staging_password>@cluster0.apporbit.mongodb.net/apporbit_staging?retryWrites=true&w=majority

# Staging Client URL
CLIENT_URL=https://staging.apporbit.io

# Staging JWT Secrets
JWT_SECRET=apporbit_staging_grade_jwt_secret_key_minimum_64_characters_entropy_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=apporbit_staging_grade_refresh_token_secret_key_minimum_64_characters_entropy_long
REFRESH_TOKEN_EXPIRES_IN=7d

# Staging Email Service
EMAIL_PROVIDER=console
EMAIL_FROM=staging@apporbit.io

# Staging Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=100

# Staging Redis
REDIS_URL=redis://staging-redis.internal:6379

# Staging Sentry
SENTRY_DSN=https://<public_key>@o123456.ingest.sentry.io/staging_id
LOG_LEVEL=debug

# Storage (Isolated Staging S3 Bucket or local)
MAX_APK_SIZE_MB=200
STORAGE_PROVIDER=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=apporbit-staging-apks
AWS_ACCESS_KEY_ID=AKIA_STAGING_KEY
AWS_SECRET_ACCESS_KEY=STAGING_SECRET

# Staging Scanner
SECURITY_SCAN_ENABLED=true
SECURITY_PROVIDER=mock

# Razorpay Test Merchant Credentials
RAZORPAY_KEY_ID=rzp_test_staging_key
RAZORPAY_KEY_SECRET=rzp_test_staging_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_staging_webhook_secret
