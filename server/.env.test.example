# ==============================================================================
# APPORBIT SERVER — TEST CONFIGURATION TEMPLATE (.env.test)
# ==============================================================================

NODE_ENV=test
PORT=5001

# Test Isolated Database
MONGODB_URI=mongodb://127.0.0.1:27017/apporbit_test

# Client URL
CLIENT_URL=http://localhost:5173

# Test JWT Secrets
JWT_SECRET=test_jwt_secret_key_apporbit_minimum_32_chars_long
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=test_refresh_token_secret_apporbit_minimum_32_chars_long
REFRESH_TOKEN_EXPIRES_IN=1d

# Test Email (Console only)
EMAIL_PROVIDER=console
EMAIL_FROM=test@apporbit.io

# Relaxed / Disabled Rate Limits for Automated Test Execution
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5000

# Local Storage Provider
STORAGE_PROVIDER=local-private
STORAGE_LOCAL_PATH=storage/test/apks
QUARANTINE_STORAGE_PATH=storage/test/quarantine

# Mock Scanner & Payments
SECURITY_SCAN_ENABLED=true
SECURITY_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_testsuite_key
RAZORPAY_KEY_SECRET=rzp_test_testsuite_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_testsuite_webhook_secret
