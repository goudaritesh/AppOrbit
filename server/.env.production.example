# ==============================================================================
# APPORBIT SERVER — PRODUCTION CONFIGURATION TEMPLATE (.env.production)
# ==============================================================================

NODE_ENV=production
PORT=5000

# MongoDB Atlas Production Replica Set URI (TLS enforced)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.apporbit.mongodb.net/apporbit_prod?retryWrites=true&w=majority&appName=AppOrbitProd

# Production Client URL (Strict HTTPS CORS Domain)
CLIENT_URL=https://apporbit.io

# Cryptographically Secure Secrets (Generate via: node -e "console.log(crypto.randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_strong_64_byte_hex_generated_secret_string_for_production_jwt
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_different_strong_64_byte_hex_generated_secret_string_prod
REFRESH_TOKEN_EXPIRES_IN=7d

# Production Transactional Email Service (SendGrid, Amazon SES, or Postmark)
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=support@apporbit.io
EMAIL_API_KEY=SG.production_key_placeholder

# Production Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=50

# Managed Redis Cloud / AWS ElastiCache for Distributed Caching & Rate Limits
REDIS_URL=rediss://default:<redis_password>@redis.apporbit.io:6379

# Production Error Monitoring & APM
SENTRY_DSN=https://<public_key>@o123456.ingest.sentry.io/7890123
LOG_LEVEL=info

# Production Cloud Object Storage (Amazon S3 / Cloudflare R2)
MAX_APK_SIZE_MB=250
STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=storage/private/apks
UPLOAD_URL_EXPIRY_SECONDS=600
DOWNLOAD_URL_EXPIRY_SECONDS=600
AWS_REGION=us-east-1
AWS_S3_BUCKET=apporbit-production-apks
AWS_ACCESS_KEY_ID=AKIA_PROD_ACCESS_KEY_PLACEHOLDER
AWS_SECRET_ACCESS_KEY=PROD_SECRET_KEY_PLACEHOLDER
APK_QUEUE_DRIVER=redis

# Production Security Scanning Pipeline
SECURITY_SCAN_ENABLED=true
SECURITY_PROVIDER=clamav
CLAMAV_HOST=clamav-service.internal
CLAMAV_PORT=3310
VIRUSTOTAL_API_KEY=vt_prod_api_key_placeholder
SECURITY_MALICIOUS_THRESHOLD=1
SECURITY_SUSPICIOUS_THRESHOLD=2
SECURITY_SCAN_TIMEOUT_SECONDS=180
SECURITY_MAX_RETRIES=2
QUARANTINE_STORAGE_PATH=storage/private/quarantine
SECURITY_REPORT_RETENTION_DAYS=730

# Live Razorpay Merchant Credentials
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_live_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_live_webhook_secret_placeholder
