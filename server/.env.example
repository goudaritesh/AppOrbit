# ==============================================================================
# APPORBIT SERVER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development, test, staging, production)
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/apporbit

# Client Application URL (CORS Whitelist)
CLIENT_URL=http://localhost:5173

# Authentication JWT & Refresh Token Secrets (Must be 32+ characters in production)
JWT_SECRET=apporbit_production_grade_jwt_secret_key_minimum_64_characters_entropy_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=apporbit_production_grade_refresh_token_secret_key_minimum_64_characters_entropy_long
REFRESH_TOKEN_EXPIRES_IN=7d

# Email Service Configuration (console, sendgrid, ses, smtp)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@apporbit.io
EMAIL_API_KEY=

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=2000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=500

# Caching & Distributed Session Storage (Optional in dev, recommended in prod)
REDIS_URL=redis://127.0.0.1:6379

# Error Monitoring & Observability (Sentry)
SENTRY_DSN=
LOG_LEVEL=info

# APK Storage & Versioning (local-private or s3)
MAX_APK_SIZE_MB=200
STORAGE_PROVIDER=local-private
STORAGE_LOCAL_PATH=storage/private/apks
UPLOAD_URL_EXPIRY_SECONDS=900
DOWNLOAD_URL_EXPIRY_SECONDS=900
AWS_REGION=us-east-1
AWS_S3_BUCKET=apporbit-private-apks
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
APK_QUEUE_DRIVER=memory

# APK Security & Antivirus Pipeline
SECURITY_SCAN_ENABLED=true
SECURITY_PROVIDER=mock
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
VIRUSTOTAL_API_KEY=
SECURITY_MALICIOUS_THRESHOLD=1
SECURITY_SUSPICIOUS_THRESHOLD=3
SECURITY_SCAN_TIMEOUT_SECONDS=300
SECURITY_MAX_RETRIES=3
SECURITY_RISK_LOW_MAX=20
SECURITY_RISK_MEDIUM_MAX=50
SECURITY_RISK_HIGH_MAX=75
QUARANTINE_STORAGE_PATH=storage/private/quarantine
SECURITY_REPORT_RETENTION_DAYS=365

# Payment & Commercial Infrastructure (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=apporbit_razorpay_webhook_secret_placeholder
