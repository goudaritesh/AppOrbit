# ==============================================================================
# APPORBIT BACKEND — PRODUCTION MULTI-STAGE DOCKERFILE (Phase 10)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Dependencies
# ------------------------------------------------------------------------------
FROM node:20-alpine AS deps
WORKDIR /app

# Install system dependencies required for native builds (if any)
RUN apk add --no-cache python3 make g++

COPY server/package*.json ./
RUN npm ci --only=production --ignore-scripts

# ------------------------------------------------------------------------------
# Stage 2: Production Minimal Runtime
# ------------------------------------------------------------------------------
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

# Install curl/wget for container health check probes
RUN apk add --no-cache wget

# Create non-root system group and user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Create persistent storage directory with safe non-root permissions
RUN mkdir -p /app/storage/private/apks /app/storage/private/quarantine \
    && chown -R appuser:appgroup /app/storage

# Copy production dependencies from deps stage
COPY --from=deps --chown=appuser:appgroup /app/node_modules ./node_modules

# Copy backend application source code
COPY --chown=appuser:appgroup server/ ./

# Drop root privileges
USER appuser

EXPOSE 5000

# Container liveness health check probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:5000/api/health/live || exit 1

CMD ["node", "server.js"]
